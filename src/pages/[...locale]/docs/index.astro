---
import Base from '../../../layouts/Base.astro';
import { publishedDocs } from '../../../lib/app-repo';
import { renderMarkdown } from '../../../lib/markdown';
import { localeStaticPaths, localeUrl, t } from '../../../i18n';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props;
const docs = publishedDocs().map((doc) => ({
  slug: doc.slug,
  ...renderMarkdown(doc.source, { docs: {}, repoUrl: () => '' }),
}));
---

<Base
  locale={locale}
  title={t(locale, 'docs.documentTitle')}
  description={t(locale, 'docs.description')}
  path="/docs/">
  <section class="page-head">
    <h1>{t(locale, 'docs.title')}</h1>
    <p class="lead">{t(locale, 'docs.lead')}</p>
  </section>
  <ul class="doc-list" lang="en" dir="ltr">
    {
      docs.map((doc) => (
        <li>
          <a href={localeUrl(locale, `/docs/${doc.slug}/`)}>{doc.title}</a>
          <p>{doc.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
