---
import site from '../../../site.config.mjs';
import Base from '../../layouts/Base.astro';
import { localeStaticPaths, localeUrl, t, type MessageKey } from '../../i18n';
import { validatePricingConfig } from '../../lib/pricing';

export function getStaticPaths() {
  return localeStaticPaths();
}

// Nothing is for sale: the app is free, and the optional cloud services are free with the limits listed here
// (the same values as the Terms of Service §2.1 and the API/bridge defaults).
const { locale } = Astro.props;
const cfg = validatePricingConfig(site.pricing);
const downloadHref = localeUrl(locale, '/download/');
const p = (key: MessageKey) => t(locale, key, { bridgeHost: site.hosts.bridge });

const freeFeatures = ['f1', 'f2', 'f3', 'f4', 'f5'] as const;
const cloudFeatures = ['f1', 'f2', 'f3', 'f4'] as const;

const faqs = [
  { id: 'open', linkHref: null, linkKey: null, external: false },
  { id: 'limits', linkHref: null, linkKey: null, external: false },
  { id: 'sponsor', linkHref: cfg.donateUrl, linkKey: 'pricing.faq.sponsor.link' as MessageKey, external: true },
] as const;
---

<Base
  locale={locale}
  title={p('pricing.documentTitle')}
  description={p('pricing.description')}
  path="/pricing/"
>
  <div class="container">
    <section class="page-head page-head--display">
      <p class="eyebrow">{p('nav.pricing')}</p>
      <h1>{p('pricing.title')}</h1>
      <p class="lead">{p('pricing.lead')}</p>
    </section>

    <div class="pricing-shell">
      <div class="plan-grid">
        <article class="plan-card plan-card-featured">
          <div class="plan-head">
            <h2>{p('pricing.free.name')}</h2>
            <span class="plan-badge plan-badge-accent">{p('pricing.free.badge')}</span>
          </div>
          <p class="price-main">
            <strong class="price-amount">{p('pricing.free.price')}</strong>
            <span class="price-unit">{p('pricing.free.period')}</span>
          </p>
          <p class="guarantee-pill">{p('pricing.free.taxNote')}</p>
          <p class="plan-summary">{p('pricing.free.summary')}</p>
          <ul class="plan-features">
            {freeFeatures.map((k) => <li>{p(`pricing.free.${k}` as MessageKey)}</li>)}
          </ul>
          <p class="plan-cta">
            <a class="button" data-fill href={downloadHref}>
              <span class="btn-fill" aria-hidden="true"></span>
              <span>{p('pricing.free.cta')}</span>
            </a>
          </p>
        </article>

        <article class="plan-card plan-card-planned">
          <div class="plan-head">
            <h2>{p('pricing.cloud.name')}</h2>
            <span class="plan-badge plan-badge-warm">{p('pricing.cloud.badge')}</span>
          </div>
          <p class="plan-summary">{p('pricing.cloud.summary')}</p>
          <ul class="plan-features">
            {cloudFeatures.map((k) => <li>{p(`pricing.cloud.${k}` as MessageKey)}</li>)}
          </ul>
          <p class="plan-note">{p('pricing.cloud.note')}</p>
        </article>
      </div>
    </div>

    <section class="pricing-section" aria-labelledby="faq-heading">
      <h2 id="faq-heading">{p('pricing.faq.title')}</h2>
      <p class="section-lead">{p('pricing.faq.lead')}</p>

      <div class="faq-list">
        {
          faqs.map((item, idx) => (
            <details class="faq-item" open={idx === 0}>
              <summary class="faq-summary">{p(`pricing.faq.${item.id}.q` as MessageKey)}</summary>
              <div class="faq-body">
                <p>{p(`pricing.faq.${item.id}.a` as MessageKey)}</p>
                {item.linkHref && item.linkKey && (
                  <p class="faq-link">
                    <a href={item.linkHref} rel={item.external ? 'noopener' : undefined}>
                      {p(item.linkKey)}
                    </a>
                  </p>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</Base>
