---
import site from '../../../site.config.mjs';
import Base from '../../layouts/Base.astro';
import { localeStaticPaths, t, type MessageKey } from '../../i18n';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props;
const groups = ['shell', 'schema', 'mcp', 'platforms', 'compat', 'open'] as const;
---

<Base
  locale={locale}
  title={t(locale, 'features.documentTitle')}
  description={t(locale, 'features.description')}
  path="/features/">
  <section class="page-head">
    <h1>{t(locale, 'features.title')}</h1>
    <p class="lead">{t(locale, 'features.lead')}</p>
  </section>
  <section class="cards">
    {
      groups.map((group) => (
        <article class="card">
          <h2>{t(locale, `features.${group}.title` as MessageKey)}</h2>
          <p>{t(locale, `features.${group}.body` as MessageKey, { license: site.license.app.name })}</p>
        </article>
      ))
    }
  </section>
</Base>
