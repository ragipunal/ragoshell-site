---
import Base from '../../layouts/Base.astro';
import { localeStaticPaths, t, trademarkNotice } from '../../i18n';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props;
---

<Base
  locale={locale}
  title={t(locale, 'trademark.documentTitle')}
  description={t(locale, 'trademark.description')}
  path="/trademark/">
  <section class="page-head">
    <h1>{t(locale, 'trademark.title')}</h1>
    <p class="lead">{trademarkNotice(locale)}</p>
    <p>{t(locale, 'trademark.nominative')}</p>
    <p>{t(locale, 'trademark.logo')}</p>
  </section>
</Base>
