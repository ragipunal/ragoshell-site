---
import site from '../../../site.config.mjs';
import Base from '../../layouts/Base.astro';
import { localeStaticPaths, localeUrl, t, type MessageKey } from '../../i18n';
import { validateCloudConfig } from '../../lib/cloud';

export function getStaticPaths() {
  return localeStaticPaths();
}

// Nothing is for sale: the client is GPLv3 free software forever, optional hosted cloud services are free with
// fair-use limits (Terms of Service §2.1), and teams can self-host endpoints via custom server profiles & enterprise.json.
const { locale } = Astro.props;
const cfg = validateCloudConfig(site.cloud);
const downloadHref = localeUrl(locale, '/download/');
const termsHref = localeUrl(locale, '/legal/terms/');
const p = (key: MessageKey) => t(locale, key);

const localFeatures = ['f1', 'f2', 'f3', 'f4', 'f5'] as const;
const hostedFeatures = ['f1', 'f2', 'f3', 'f4'] as const;
const selfhostFeatures = ['f1', 'f2', 'f3', 'f4'] as const;

const wireOrder = ['local', 'hosted', 'selfhost'] as const;
interface WireRow {
  key: string;
  tag: string;
  val: string;
  warm?: boolean;
}
interface WirePreset {
  cmd: string;
  desc: string;
  status: string;
  rows: ReadonlyArray<WireRow>;
}
const wirePresets: Record<(typeof wireOrder)[number], WirePreset> = {
  local: {
    cmd: 'mongocxx::client("mongodb://127.0.0.1:27017")',
    desc: p('cloud.wire.desc.local'),
    status: 'OFFLINE · ZERO TELEMETRY',
    rows: [
      { key: 'auth', tag: 'SCRAM-SHA-256', val: 'direct TCP / TLS to your cluster' },
      { key: 'cloudAccount', tag: 'Null', val: 'not required' },
      { key: 'telemetry', tag: 'Bool', val: 'disabled' },
      { key: 'license', tag: 'SPDX', val: site.license.app.name },
    ],
  },
  hosted: {
    cmd: `sync.seal({ api: "${site.urls.api}", kdf: "Argon2id" })`,
    desc: p('cloud.wire.desc.hosted'),
    status: 'OPT-IN · FREE QUOTA',
    rows: [
      { key: 'cipher', tag: 'KDF + AEAD', val: 'Argon2id + AES-256-GCM (device-only key)', warm: true },
      { key: 'syncQuota', tag: 'Limits', val: '20 collections x 1 MiB, 500 uploads/day', warm: true },
      { key: 'devices', tag: 'RFC 8628', val: '3 active devices max per account' },
      { key: 'privacy', tag: 'KVKK · GDPR', val: 'TOTP 2FA, JSON export, 30d erasure', warm: true },
    ],
  },
  selfhost: {
    cmd: 'PolicyLock::load("enterprise.json")',
    desc: p('cloud.wire.desc.selfhost'),
    status: 'SOVEREIGN · POLICY LOCKED',
    rows: [
      { key: 'profile', tag: 'HTTPS', val: `custom endpoints (api.${site.domain} override)` },
      { key: 'allowExternalCloud', tag: 'Bool', val: 'false (enforced by enterprise.json)' },
      { key: 'bridge', tag: site.license.bridge.name, val: 'self-hosted relay with private TLS & egress' },
      { key: 'perSeatFee', tag: 'None', val: 'zero licensing or telemetry callbacks' },
    ],
  },
};
const initialWire = wirePresets.local;

const faqs = [
  { id: 'open', linkHref: null, linkKey: null, external: false },
  { id: 'limits', linkHref: null, linkKey: null, external: false },
  { id: 'selfhost', linkHref: null, linkKey: null, external: false },
  { id: 'sponsor', linkHref: cfg.donateUrl, linkKey: 'cloud.faq.sponsor.link' as MessageKey, external: true },
] as const;
---

<Base
  locale={locale}
  title={p('cloud.documentTitle')}
  description={p('cloud.description')}
  path="/cloud/"
>
  <div class="container">
    <section class="page-head page-head--display">
      <p class="eyebrow">{p('nav.cloud')}</p>
      <h1>{p('cloud.title')}</h1>
      <p class="lead">{p('cloud.lead')}</p>
    </section>

    <div class="cloud-shell">
      <div class="cloud-grid">
        <article class="cloud-card cloud-card-featured">
          <div class="cloud-head">
            <h2>{p('cloud.local.name')}</h2>
            <span class="cloud-badge cloud-badge-accent">{p('cloud.local.badge')}</span>
          </div>
          <p class="cloud-pill">{p('cloud.local.pill')}</p>
          <p class="cloud-summary">{p('cloud.local.summary')}</p>
          <ul class="cloud-features">
            {localFeatures.map((k) => <li>{p(`cloud.local.${k}` as MessageKey)}</li>)}
          </ul>
          <p class="cloud-cta">
            <a class="button" data-fill href={downloadHref}>
              <span class="btn-fill" aria-hidden="true"></span>
              <span>{p('cloud.local.cta')}</span>
            </a>
          </p>
        </article>

        <article class="cloud-card cloud-card-hosted">
          <div class="cloud-head">
            <h2>{p('cloud.hosted.name')}</h2>
            <span class="cloud-badge cloud-badge-warm">{p('cloud.hosted.badge')}</span>
          </div>
          <p class="cloud-pill cloud-pill-warm">{p('cloud.hosted.pill')}</p>
          <p class="cloud-summary">{p('cloud.hosted.summary')}</p>
          <ul class="cloud-features">
            {hostedFeatures.map((k) => <li>{p(`cloud.hosted.${k}` as MessageKey)}</li>)}
          </ul>
          <div class="cloud-note">
            <p class="cloud-note-text">{p('cloud.hosted.note')}</p>
            <a class="cloud-terms-link" href={termsHref}>{p('cloud.hosted.termsLink')}</a>
          </div>
          {
            cfg.mode === 'live' && cfg.registerUrl && cfg.loginUrl && (
              <div class="cloud-cta cloud-cta--stack">
                <a class="button" data-fill href={cfg.registerUrl} rel="noopener">
                  <span class="btn-fill" aria-hidden="true"></span>
                  <span>{p('cloud.hosted.cta')}</span>
                </a>
                <a class="cloud-signin-link" href={cfg.loginUrl} rel="noopener">{p('cloud.hosted.signIn')}</a>
              </div>
            )
          }
        </article>

        <article class="cloud-card cloud-card-selfhost">
          <div class="cloud-head">
            <h2>{p('cloud.selfhost.name')}</h2>
            <span class="cloud-badge">{p('cloud.selfhost.badge')}</span>
          </div>
          <p class="cloud-pill cloud-pill-neutral">{p('cloud.selfhost.pill')}</p>
          <p class="cloud-summary">{p('cloud.selfhost.summary')}</p>
          <ul class="cloud-features">
            {selfhostFeatures.map((k) => <li>{p(`cloud.selfhost.${k}` as MessageKey)}</li>)}
          </ul>
          <p class="cloud-cta">
            <a class="button secondary" data-fill href={site.repo.appRepoUrl} rel="noopener noreferrer">
              <span class="btn-fill" aria-hidden="true"></span>
              <span>{p('cloud.selfhost.cta')}</span>
            </a>
          </p>
        </article>
      </div>
    </div>

    <section class="wire-section" aria-labelledby="wire-heading">
      <div class="wire-head">
        <p class="eyebrow">{p('cloud.wire.eyebrow')}</p>
        <h2 id="wire-heading">{p('cloud.wire.title')}</h2>
      </div>

      <div class="shell-stage wire-stage" data-wire-stage data-presets={JSON.stringify(wirePresets)}>
        <div class="stage-topbar">
          <span class="stage-engine">
            <span class="stage-beacon" aria-hidden="true"></span>
            <span>enterprise.json · Zero-Knowledge</span>
          </span>
          <div class="stage-clock-wrap">
            <span class="stage-mode">{p('cloud.wire.footerMode')}</span>
          </div>
        </div>

        <div class="stage-telemetry-track" aria-hidden="true">
          <div class="stage-telemetry-bar" data-wire-pulse></div>
        </div>

        <div class="stage-tabs wire-tabs" role="tablist" aria-label={p('cloud.wire.title')}>
          {
            wireOrder.map((key, idx) => (
              <button
                type="button"
                role="tab"
                class={`stage-tab${idx === 0 ? ' is-active' : ''}`}
                data-wire-tab={key}
                aria-selected={idx === 0 ? 'true' : 'false'}
              >
                {p(`cloud.wire.tab.${key}` as MessageKey)}
              </button>
            ))
          }
        </div>

        <div class="stage-screen">
          <div class="stage-cmd-row">
            <span class="stage-prompt" aria-hidden="true">&gt;</span>
            <code class="stage-cmd" data-wire-cmd>{initialWire.cmd}</code>
          </div>
          <div class="bson-tree" data-wire-body>
            {
              initialWire.rows.map((row) => (
                <div class="bson-line">
                  <span class="bson-key">{row.key}</span>
                  <span class="bson-type">{row.tag}</span>
                  <span class={row.warm ? 'bson-val bson-val--wire-warm' : 'bson-val bson-val--objectid'}>{row.val}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="stage-foot">
          <p class="stage-desc" data-wire-desc>{initialWire.desc}</p>
          <span class="stage-elapsed" data-wire-status>{initialWire.status}</span>
        </div>
      </div>
    </section>

    <section class="support-band" aria-labelledby="support-heading">
      <div class="support-copy">
        <p class="eyebrow">{p('cloud.support.eyebrow')}</p>
        <h2 id="support-heading">{p('cloud.support.title')}</h2>
        <p class="support-body">{p('cloud.support.body')}</p>
      </div>
      <div class="support-actions">
        <a class="button secondary" data-fill href={cfg.donateUrl} rel="noopener noreferrer">
          <span class="btn-fill" aria-hidden="true"></span>
          <span>{p('cloud.support.cta')}</span>
        </a>
      </div>
    </section>

    <section class="cloud-section" aria-labelledby="faq-heading">
      <h2 id="faq-heading">{p('cloud.faq.title')}</h2>
      <p class="section-lead">{p('cloud.faq.lead')}</p>

      <div class="faq-list">
        {
          faqs.map((item, idx) => (
            <details class="faq-item" open={idx === 0}>
              <summary class="faq-summary">{p(`cloud.faq.${item.id}.q` as MessageKey)}</summary>
              <div class="faq-body">
                <p>{p(`cloud.faq.${item.id}.a` as MessageKey)}</p>
                {item.linkHref && item.linkKey && (
                  <p class="faq-link">
                    <a href={item.linkHref} rel={item.external ? 'noopener noreferrer' : undefined}>
                      {p(item.linkKey)}
                    </a>
                  </p>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</Base>
