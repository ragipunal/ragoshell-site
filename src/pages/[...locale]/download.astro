---
import site from '../../../site.config.mjs';
import Base from '../../layouts/Base.astro';
import { localeStaticPaths, localeUrl, t, type MessageKey } from '../../i18n';
import { changelogReleases } from '../../lib/app-repo';
import { validateDemoConfig } from '../../lib/cloud';
import { jsonLdDocument, softwareNode } from '../../lib/seo';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props;
const demo = validateDemoConfig(site.demo);
const latestVersion = changelogReleases()[0]?.version ?? '';
const platforms = site.download.platforms as string[];
const hasPackage = (platform: string) => ['windows', 'macos', 'linux'].includes(platform);
const note = (platform: string): string | null => {
  if (platform === 'windows') return t(locale, 'download.note.windows');
  if (platform === 'macos') return t(locale, 'download.note.macos');
  if (platform === 'android') return t(locale, 'download.note.android');
  if (platform === 'ios') return t(locale, 'download.note.ios');
  return null;
};
const description = t(locale, 'download.description');
const software = softwareNode({
  name: site.productName,
  url: new URL(localeUrl(locale, '/download/'), site.url).href,
  description,
  language: locale,
  operatingSystems: platforms.map((p) => t(locale, `download.platform.${p}` as MessageKey)),
  license: site.license.app.url,
  downloadUrl: site.download.allDownloadsUrl,
});
const keep = (key: MessageKey, names: string[]) =>
  t(locale, key, Object.fromEntries(names.map((n) => [n, `{${n}}`])));
---

<Base
  locale={locale}
  title={t(locale, 'download.documentTitle')}
  description={description}
  path="/download/"
  jsonLd={jsonLdDocument([software])}
>
  <div class="container">
    <section class="page-head page-head--display">
      <p class="eyebrow">{t(locale, 'nav.status')}</p>
      <h1>{t(locale, 'download.title')}</h1>
      <p class="lead">{t(locale, 'download.lead')}</p>
    </section>

    <section
      class="download-stage"
      data-download
      data-releases={site.releasesPath}
      data-hosts={site.download.allowedHosts.join(',')}
      data-dl-host={site.hosts.dl}
      data-primary-template={keep('download.primary', ['platform'])}
      data-version-template={keep('download.version', ['version'])}
      data-released-template={keep('download.released', ['date'])}
      data-get={t(locale, 'download.get')}
    >
      <div class="primary" data-primary hidden>
        <p class="meta" data-version-text></p>
        <p>
          <a class="button" data-fill data-primary-link href={site.download.allDownloadsUrl} hidden>
            <span class="btn-fill" aria-hidden="true"></span>
            <span data-primary-label>{t(locale, 'download.all')}</span>
          </a>
        </p>
      </div>

      <div class="release-ledger">
        <div class="release-ledger-meta">
          {
            latestVersion && (
              <a class="release-tag-link" href={localeUrl(locale, '/changes/')}>
                {t(locale, 'download.latestTag', { version: latestVersion })}
              </a>
            )
          }
          <code class="release-verify-pill">SHA256SUMS.txt · SHA256SUMS.txt.minisig</code>
        </div>
        <div class="release-ledger-actions">
          {
            demo.enabled && (
              <a class="button secondary" data-fill href={demo.url} rel="noopener">
                <span class="btn-fill" aria-hidden="true"></span>
                <span>{t(locale, 'download.demoCta')}</span>
              </a>
            )
          }
          <a class="button secondary" data-fill href={site.download.allDownloadsUrl} rel="noopener noreferrer">
            <span class="btn-fill" aria-hidden="true"></span>
            <span>{t(locale, 'download.verifyCta')}</span>
          </a>
        </div>
      </div>

      <div class="platforms-wrap">
        <table class="platforms">
          <thead>
            <tr>
              <th scope="col">{t(locale, 'download.col.platform')}</th>
              <th scope="col">{t(locale, 'download.col.requirements')}</th>
              <th scope="col">{t(locale, 'download.col.get')}</th>
            </tr>
          </thead>
          <tbody>
            {
              platforms.map((platform) => {
                const platformName = t(locale, `download.platform.${platform}` as MessageKey);
                return (
                  <tr data-platform={platform} data-name={platformName}>
                    <th scope="row">{platformName}</th>
                    <td>
                      {t(locale, `download.req.${platform}` as MessageKey)}
                      {note(platform) && <p class="note">{note(platform)}</p>}
                    </td>
                    <td data-action>
                      {hasPackage(platform) ? (
                        <a class="table-action-link" href={site.download.allDownloadsUrl} rel="noopener">
                          {t(locale, 'download.allFor', { platform: platformName })}
                        </a>
                      ) : (
                        <span class="meta">{t(locale, 'download.unavailable')}</span>
                      )}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="download-preview" aria-labelledby="download-preview-heading">
      <p class="eyebrow">{t(locale, 'download.preview.eyebrow')}</p>
      <h2 id="download-preview-heading" class="screens-heading">{t(locale, 'download.preview.title')}</h2>

      <figure class="screen-frame">
        <div class="screen-chrome" aria-hidden="true">
          <span class="screen-led"></span>
          <span class="screen-chrome-label">{t(locale, 'home.surface.desktop.chrome')}<span class="screen-chrome-meta">{t(locale, 'home.surface.desktop.chromeMeta')}</span></span>
        </div>
        <img
          src="/screens/ui-shell-desktop.webp"
          alt={t(locale, 'home.surface.desktop.alt')}
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{t(locale, 'download.preview.caption')}</figcaption>
      </figure>
    </section>
  </div>
</Base>

<script>
  import '../../scripts/download';
</script>
