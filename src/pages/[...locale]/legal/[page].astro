---
import site from '../../../../site.config.mjs';
import Base from '../../../layouts/Base.astro';
import { localeInfo, localeStaticPaths, t, type MessageKey } from '../../../i18n';
import { renderLegalDocument } from '../../../lib/legal';

export function getStaticPaths() {
  return localeStaticPaths(site.legalPages.map((page: string) => ({ params: { page }, props: { page } })));
}

const { locale, page } = Astro.props as { locale: string; page: string };
const shortTitle = t(locale, `legal.${page}.title` as MessageKey);
const description = t(locale, `legal.${page}.description` as MessageKey, { license: site.license.app.name });
const rendered = renderLegalDocument(locale, page);
const contents = rendered.headings.filter((h) => h.depth === 2 || h.depth === 3);
const sourceInfo = localeInfo(rendered.sourceLocale);
const pageLocaleInfo = localeInfo(locale);
const isFallback = rendered.sourceLocale !== locale;
---

<Base
  locale={locale}
  title={t(locale, 'legal.documentTitle', { title: shortTitle })}
  description={description}
  path={`/legal/${page}/`}
  noindex={site.legal.draft}
>
  <div class="container">
    <section class="page-head">
      <p class="eyebrow">{t(locale, 'footer.legal')}</p>
      <h1>{rendered.title}</h1>
      {site.legal.draft && <p class="status-banner">{t(locale, 'legal.draftNotice', { date: site.legal.draftDate })}</p>}
      {isFallback && <p class="status-banner">{t(locale, 'docs.englishOnly')}</p>}
    </section>

    <div class="doc-layout" lang={sourceInfo.code} dir={sourceInfo.dir}>
      {
        contents.length > 0 && (
          <nav class="toc" aria-label={t(locale, 'docs.contents')}>
            <p class="toc-title" lang={pageLocaleInfo.code} dir={pageLocaleInfo.dir}>{t(locale, 'docs.contents')}</p>
            <div class="toc-list">
              {contents.map((h) => (
                <a class={`toc-link depth-${h.depth}`} href={`#${h.id}`}>
                  {h.text}
                </a>
              ))}
            </div>
          </nav>
        )
      }
      <article class="prose doc" set:html={rendered.html} />
    </div>
  </div>
</Base>
