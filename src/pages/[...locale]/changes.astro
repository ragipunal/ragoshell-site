---
import site from '../../../site.config.mjs';
import Base from '../../layouts/Base.astro';
import { changelogReleases } from '../../lib/app-repo';
import { codeSpans, releaseAnchor } from '../../lib/changelog';
import { localeStaticPaths, t } from '../../i18n';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props;
const releases = changelogReleases();
const isFallback = locale !== site.docs.language;
---

<Base
  locale={locale}
  title={t(locale, 'changes.documentTitle')}
  description={t(locale, 'changes.description')}
  path="/changes/"
>
  <div class="container">
    <section class="page-head page-head--display">
      <p class="eyebrow">{t(locale, 'nav.changes')}</p>
      <h1>{t(locale, 'changes.title')}</h1>
      <p class="lead">{t(locale, 'changes.lead')}</p>
    </section>

    {isFallback && <p class="status-banner">{t(locale, 'docs.englishOnly')}</p>}

    <!-- The change log body is English: it is shown as written, in an English LTR block. -->
    <div class="changelog-list">
      {
        releases.map((release, idx) =>
          idx < 2 ? (
            <article class="changelog-entry" id={releaseAnchor(release.version)}>
              <div class="changelog-ver">
                <h2>{t(locale, 'changes.version', { version: release.version })}</h2>
              </div>
              <div class="changelog-body" lang="en" dir="ltr">
                {release.intro !== '' && <p>{release.intro}</p>}
                <ul>
                  {release.items.map((item) => (
                    <li>
                      {codeSpans(item).map((part) => (part.code ? <code>{part.text}</code> : part.text))}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ) : (
            <details class="changelog-entry changelog-fold" id={releaseAnchor(release.version)}>
              <summary class="changelog-fold-summary">
                <span class="changelog-ver-tag">{t(locale, 'changes.version', { version: release.version })}</span>
                <span class="changelog-fold-meta">v{release.version} ({release.items.length})</span>
              </summary>
              <div class="changelog-body" lang="en" dir="ltr">
                {release.intro !== '' && <p>{release.intro}</p>}
                <ul>
                  {release.items.map((item) => (
                    <li>
                      {codeSpans(item).map((part) => (part.code ? <code>{part.text}</code> : part.text))}
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ),
        )
      }
    </div>
  </div>
</Base>
