---
import site from '../../site.config.mjs';
import BrandMark from './BrandMark.astro';
import Wordmark from './Wordmark.astro';
import { localeUrl, t, trademarkNotice, type MessageKey } from '../i18n';
import { trademarkPath } from '../nav';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const { code, content } = site.license;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-finale">
      <p class="footer-brand">
        <BrandMark size={34} />
        <Wordmark />
      </p>
      <p class="footer-stamp">{t(locale, 'footer.stamp')}</p>
    </div>

    <div class="footer-grid">
      <div class="footer-hero-col">
        <div class="footer-notice">{trademarkNotice(locale)}</div>
        <div class="footer-notice">{t(locale, 'footer.noCookies')}</div>
      </div>

    <div class="footer-links-col">
      <nav aria-label={t(locale, 'footer.legal')}>
        <p class="footer-col-title">{t(locale, 'footer.legal')}</p>
        <ul class="footer-links">
          {
            site.legalPages.map((page: string) => (
              <li>
                <a class="utility-link" href={localeUrl(locale, `/legal/${page}/`)}>
                  {t(locale, `legal.${page}.title` as MessageKey)}
                </a>
              </li>
            ))
          }
          <li>
            <a class="utility-link" href={localeUrl(locale, trademarkPath)}>{t(locale, 'nav.trademark')}</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="footer-meta-col">
      <p class="footer-col-title">{t(locale, 'footer.source')}</p>
      <ul class="footer-links">
        <li>
          <span class="meta-label">{t(locale, 'footer.codeLicense')}:</span>{' '}
          <a class="utility-link" href={code.url} rel="license noopener">{code.name}</a>
        </li>
        <li>
          <span class="meta-label">{t(locale, 'footer.contentLicense')}:</span>{' '}
          <a class="utility-link" href={content.url} rel="license noopener">{content.name}</a>
        </li>
        <li>
          <a class="utility-link" href={site.repo.siteRepoUrl} rel="noopener">{t(locale, 'footer.source')}</a>
        </li>
      </ul>
      </div>
    </div>
  </div>
</footer>
