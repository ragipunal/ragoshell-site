---
import { locales, localeUrl, t } from '../i18n';

interface Props {
  locale: string;
  path: string;
}
const { locale, path } = Astro.props;
const current = locales.find((l) => l.code === locale);
---

<nav class="lang" aria-label={t(locale, 'lang.label')}>
  <details data-disclosure>
    <summary class="lang-toggle">
      <span class="lang-code" aria-hidden="true">{current?.code.toUpperCase()}</span>
      <span class="lang-name">{current?.label}</span>
    </summary>
    <ul class="lang-list">
      {
        locales.map((l) => (
          <li>
            <a
              class="lang-option"
              href={localeUrl(l.code, path)}
              lang={l.code}
              hreflang={l.code}
              dir={l.dir}
              aria-current={l.code === locale ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</nav>
